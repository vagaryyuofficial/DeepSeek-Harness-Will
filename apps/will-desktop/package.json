    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-query": "workspace:^",
    "@deepseek-ai/dsh-session-stats": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-shell-env": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^",
    "@deepseek-ai/dsh-tool-workflow": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-typert-registry": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@deepseek-ai/dsh-web": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "electron-updater": "6.6.3",
    "js-yaml": "^4.2.0",
    "pnpm": "11.7.0"
  },
  "optionalDependencies": {
    "@koromix/koffi-darwin-arm64": "3.1.1",
    "@koromix/koffi-darwin-x64": "3.1.1",
    "@koromix/koffi-win32-x64": "3.1.1",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-darwin-arm64": "0.1.4",
    "node-addon-require-builtin-darwin-x64": "0.1.4",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "org.deepseek-harness-will.desktop",
    "productName": "Deepseek Harness Will — 组装未来",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vagaryyuofficial",
        "repo": "DeepSeek-Harness-Will"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "artifactName": "DeepSeek-Harness-Will-${version}-macOS-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "DeepSeek-Harness-Will-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Will-Portable-${version}-${arch}.${ext}"
    }
  }
}
