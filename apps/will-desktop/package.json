{
  "name": "@deepseek-harness-will/desktop",
  "version": "0.1.3",
  "description": "A portable desktop distribution of DeepSeek Harness with opt-in Will customizations",
  "author": "DeepSeek Harness Will contributors",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run verify:runtime-closure && node scripts/build.mjs && tsc --noEmit",
    "icon:render": "node scripts/render-icon.mjs",
    "test": "vitest run",
    "verify:runtime-closure": "tsx ../../scripts/verify-runtime-closure.ts --manifest apps/will-desktop/package.json",
    "dev": "pnpm run build && electron .",
    "package:dir": "pnpm run build && electron-builder --dir",
    "package:win": "pnpm run build && electron-builder --win nsis portable --x64",
    "package:mac": "pnpm run build && electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
